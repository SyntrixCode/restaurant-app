  "cloudFunctions": {
    "auth": {
      "verifyUserCode": {
        "type": "HTTPS Callable",
        "input": { "kod": "string (4 hane)" },
        "output": { "token": "string", "userId": "string", "rol": "string", "ad": "string" },
        "errors": ["auth/invalid-code", "auth/rate-limited"],
        "logic": "Kod hash, users'ta ara, aktif ise custom token üret",
        "rateLimit": "5 yanlış deneme → 60sn kilit"
      },
      "hashUserCode": {
        "type": "Firestore onCreate trigger",
        "collection": "users",
        "logic": "Yeni kullanıcının kodunu otomatik hash'le"
      }
    },
    "orders": {
      "onOrderCreate": {
        "type": "Firestore onCreate trigger",
        "collection": "orders",
        "actions": [
          "Stokları atomik transaction ile düş",
          "Masa durumunu 'dolu' yap",
          "Mutfak yazıcısına ESC/POS gönder",
          "Admin bildirimi oluştur"
        ]
      },
      "onOrderUpdate": {
        "type": "Firestore onUpdate trigger",
        "collection": "orders",
        "actions": [
          "Items değişti ise stok farkını hesapla",
          "Durum 'tamamlandi' → archivedOrders'a kopyala",
          "Durum 'iptal' → stokları geri yükle"
        ]
      },
      "onPaymentCreate": {
        "type": "Firestore onCreate trigger",
        "collection": "payments",
        "actions": [
          "İlgili order'ı 'tamamlandi' yap",
          "Masa'yı 'boş' yap (grup ise tümü)",
          "Günlük satış istatistiğini güncelle"
        ]
      }
    },
    "scheduled": {
      "checkLateOrders": {
        "schedule": "every 1 minutes",
        "logic": "Aktif siparişleri tara, 15dk eşiği geçenleri işaretle ve bildirim oluştur"
      },
      "checkLowStock": {
        "schedule": "every 5 minutes",
        "logic": "Aktif ürünleri tara, eşik altındakiler için bildirim (saatte 1 kez)"
      },
      "archiveOldOrders": {
        "schedule": "every day at 03:00",
        "logic": "30 günden eski archivedOrders'ı sil (özet ayrı koleksiyonda kalır)"
      },
      "dailyReportSnapshot": {
        "schedule": "every day at 23:59",
        "logic": "Günlük rapor snapshot'ı dailyReports'a kaydet"
      }
    },
    "integrations": {
      "yemeksepetiWebhook": {
        "type": "HTTPS endpoint",
        "logic": "Yemeksepeti'nden gelen siparişi orders'a ekle (paketMi: true)"
      },
      "getirWebhook": {
        "type": "HTTPS endpoint",
        "logic": "Getir entegrasyonu"
      },
      "callerIdHandler": {
        "type": "HTTPS endpoint",
        "logic": "CallerID donanımından gelen aramayı callerLogs'a yaz"
      }
    },
    "printing": {
      "printKitchenReceipt": {
        "logic": "Yazıcı IP'sine ESC/POS, format: tarih+masa+garson+ürünler (büyük)+notlar",
        "optional": "Kategori bazlı yazıcı yönlendirme"
      },
      "printCustomerReceipt": {
        "logic": "POS terminal yazıcısı için yedek (Faz 4'te Capacitor native ile yapılır)"
      }
    }
  },

