{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restoran POS Sistemi - Proje Şeması",
  "version": "1.0.0",
  "description": "iMin Swan 1 Android POS cihazları için restoran yönetim yazılımı tam spesifikasyonu",
  "lastUpdated": "2026-05-22",

  "project": {
    "name": "Restoran POS Sistemi",
    "target": "Tek şube restoran",
    "hardware": {
      "device": "iMin Swan 1 Android POS PC",
      "count": 3,
      "deployment": {
        "device1": { "type": "garson terminali", "primaryUse": "sipariş alma" },
        "device2": { "type": "garson terminali", "primaryUse": "sipariş alma" },
        "device3": { "type": "kasa terminali", "primaryUse": "sipariş alma + ödeme + paket servis" }
      },
      "specs": {
        "os": "Android 11",
        "ram": "4 GB",
        "storage": "32 GB",
        "mainScreen": "15.6 inch 1920x1080 touch",
        "secondaryScreen": "10.1 inch (opsiyonel, müşteri ekranı)",
        "features": ["NFC (2. ekranda)", "Dahili kamera", "Yerleşik 1.5W hoparlör"],
        "connectivity": ["WiFi 2.4GHz", "Ethernet 100M", "Bluetooth 4.2"],
        "ports": ["3x USB-A", "1x RJ12 (şarj)", "1x RJ11 (seri/yazıcı)", "1x RJ45 (Ethernet)", "1x Micro-SD"]
      }
    }
  },

  "techStack": {
    "frontend": {
      "framework": { "name": "React", "version": "18.x" },
      "router": { "name": "React Router DOM", "version": "6.x" },
      "state": { "name": "Zustand", "version": "latest" },
      "styling": { "name": "Tailwind CSS", "version": "3.x" },
      "cssProcessing": ["PostCSS", "Autoprefixer"]
    },
    "build": {
      "bundler": { "name": "Vite", "version": "5.x" },
      "pwa": "vite-plugin-pwa",
      "serviceWorker": "Workbox"
    },
    "backend": {
      "platform": "Firebase",
      "version": "12.x",
      "services": {
        "database": "Firestore",
        "auth": "Firebase Authentication",
        "hosting": "Firebase Hosting",
        "functions": "Cloud Functions",
        "storage": "Firebase Storage"
      }
    },
    "libraries": [
      { "name": "react-dnd veya dnd-kit", "purpose": "Masa düzeni sürükle-bırak" },
      { "name": "recharts", "purpose": "Dashboard grafikleri" },
      { "name": "xlsx veya exceljs", "purpose": "Excel export" },
      { "name": "date-fns", "purpose": "Tarih işlemleri (TR locale)" },
      { "name": "react-hot-toast", "purpose": "Bildirim toastları" },
      { "name": "react-hook-form", "purpose": "Form yönetimi" },
      { "name": "zod", "purpose": "Şema validasyon" },
      { "name": "lucide-react", "purpose": "İkonlar" },
      { "name": "html5-qrcode", "purpose": "QR okuma (kamera)" },
      { "name": "qrcode.react", "purpose": "QR oluşturma" }
    ],
    "posDevice": {
      "wrapper": { "name": "Capacitor", "version": "6.x", "addedInPhase": 4 },
      "nativeSDKs": [
        { "name": "iMin Printer SDK", "purpose": "Yazıcı, kasa çekmecesi" },
        { "name": "iMin Dual Screen SDK", "purpose": "2. ekran kontrolü" },
        { "name": "Capacitor NFC plugin", "purpose": "NFC okuma (opsiyonel)" }
      ]
    }
  },

  "roles": {
    "admin": {
      "description": "Restoran sahibi/yöneticisi, tam yetkili",
      "authMethod": "Firebase Auth (email/şifre)",
      "permissions": {
        "userManagement": true,
        "menuManagement": true,
        "tableLayoutEditor": true,
        "orderEntry": true,
        "payment": true,
        "orderCancel": true,
        "dashboard": true,
        "reports": true,
        "campaigns": true,
        "stockManagement": true,
        "notificationSettings": true,
        "packageDelivery": true,
        "systemSettings": true
      }
    },
    "kasiyer": {
      "description": "Kasa terminalinde çalışır",
      "authMethod": "4 haneli kod",
      "permissions": {
        "userManagement": false,
        "menuManagement": false,
        "tableLayoutEditor": false,
        "orderEntry": true,
        "payment": true,
        "orderCancel": false,
        "dashboard": true,
        "reports": false,
        "campaigns": false,
        "stockManagement": false,
        "notificationSettings": false,
        "packageDelivery": true,
        "systemSettings": false
      }
    },
    "garson": {
      "description": "POS terminallerinde çalışır, sadece sipariş alır",
      "authMethod": "4 haneli kod",
      "permissions": {
        "userManagement": false,
        "menuManagement": false,
        "tableLayoutEditor": false,
        "orderEntry": true,
        "payment": false,
        "orderCancel": false,
        "dashboard": false,
        "reports": false,
        "campaigns": false,
        "stockManagement": false,
        "notificationSettings": false,
        "packageDelivery": false,
        "systemSettings": false
      }
    }
  },

  "firestore": {
    "collections": {
      "users": {
        "description": "Sistem kullanıcıları (admin, kasiyer, garson)",
        "fields": {
          "id": { "type": "string", "required": true, "description": "Doküman ID (otomatik)" },
          "ad": { "type": "string", "required": true, "maxLength": 100 },
          "kodHash": { "type": "string", "required": true, "description": "4 haneli kodun SHA-256 hash'i" },
          "kodIpucu": { "type": "string", "maxLength": 4, "description": "Maskelenmiş kod (örn. '1***')" },
          "rol": { "type": "string", "enum": ["admin", "kasiyer", "garson"], "required": true },
          "aktif": { "type": "boolean", "default": true },
          "createdAt": { "type": "timestamp" },
          "updatedAt": { "type": "timestamp" }
        }
      },
      "categories": {
        "description": "Menü kategorileri",
        "fields": {
          "id": { "type": "string", "required": true },
          "ad": { "type": "string", "required": true, "maxLength": 100 },
          "sira": { "type": "number", "default": 0, "description": "Drag-drop ile değişen sıralama" },
          "aktif": { "type": "boolean", "default": true },
          "yaziciId": { "type": "string", "nullable": true, "ref": "printers", "description": "Bu kategorideki ürünler hangi mutfak yazıcısına gider. null ise varsayılan yazıcı." },
          "urunSayisi": { "type": "number", "default": 0, "description": "Cached, Cloud Function ile güncellenir" },
          "createdAt": { "type": "timestamp" },
          "updatedAt": { "type": "timestamp" }
        },
        "defaults": [
          "Kahvaltı", "Çorbalar", "Ara Sıcaklar", "Salatalar", "Pideler",
          "Yöresel Lezzetler", "Tatlılar", "İçecekler", "Dürümler", "Şarküteri"
        ]
      },
      "products": {
        "description": "Menü ürünleri",
        "fields": {
          "id": { "type": "string", "required": true },
          "ad": { "type": "string", "required": true, "maxLength": 200 },
          "fiyat": { "type": "number", "required": true, "min": 0, "description": "TL cinsinden" },
          "stok": { "type": "number", "required": true, "min": 0, "default": 0 },
          "dusukStokEsigi": { "type": "number", "nullable": true, "description": "null ise global ayar kullanılır" },
          "categoryId": { "type": "string", "required": true, "ref": "categories" },
          "categoryAd": { "type": "string", "description": "Denormalize, hızlı görüntüleme için" },
          "aciklama": { "type": "string" },
          "gorsel": { "type": "string", "description": "Firebase Storage URL" },
          "aktif": { "type": "boolean", "default": true },
          "createdAt": { "type": "timestamp" },
          "updatedAt": { "type": "timestamp" }
        }
      },
      "tables": {
        "description": "Restoran masaları",
        "fields": {
          "id": { "type": "string", "required": true },
          "ad": { "type": "string", "required": true, "examples": ["Masa 1", "Teras-3"] },
          "zone": { "type": "string", "enum": ["ic", "dis", "teras"], "required": true },
          "kapasite": { "type": "number", "enum": [2, 4, 6, 8], "required": true },
          "x": { "type": "number", "description": "Layout editor X koordinatı (px)" },
          "y": { "type": "number", "description": "Layout editor Y koordinatı (px)" },
          "w": { "type": "number", "description": "Genişlik" },
          "h": { "type": "number", "description": "Yükseklik" },
          "durum": { "type": "string", "enum": ["bos", "dolu", "rezerve"], "default": "bos" },
          "grupId": { "type": "string", "nullable": true, "ref": "tableGroups" },
          "rezervasyonNotu": { "type": "string", "nullable": true },
          "siraNo": { "type": "number" },
          "createdAt": { "type": "timestamp" }
        }
      },
      "tableGroups": {
        "description": "Birleştirilmiş masa grupları",
        "fields": {
          "id": { "type": "string", "required": true },
          "masaIds": { "type": "array", "items": "string", "description": "Gruba dahil masa ID'leri" },
          "durum": { "type": "string", "enum": ["dolu", "rezerve"] },
          "anaMasaId": { "type": "string", "description": "Siparişlerin yazıldığı ana masa" },
          "createdAt": { "type": "timestamp" }
        }
      },
      "orders": {
        "description": "Aktif siparişler (tamamlananlar archivedOrders'a taşınır)",
        "fields": {
          "id": { "type": "string", "required": true },
          "masaId": { "type": "string", "nullable": true, "description": "Paket sipariş ise null" },
          "masaAd": { "type": "string", "nullable": true, "description": "Denormalize" },
          "garsonId": { "type": "string", "required": true },
          "garsonAd": { "type": "string", "required": true },
          "durum": {
            "type": "string",
            "enum": ["aktif", "hazirlandi", "masayaGitti", "tamamlandi", "iptal"],
            "default": "aktif"
          },
          "items": {
            "type": "array",
            "items": {
              "productId": "string",
              "ad": "string",
              "fiyat": "number",
              "adet": "number",
              "notlar": "string",
              "eklenmeZamani": "timestamp"
            }
          },
          "araToplam": { "type": "number" },
          "indirim": { "type": "number", "default": 0 },
          "kuponKodu": { "type": "string", "nullable": true },
          "kampanyaId": { "type": "string", "nullable": true },
          "toplam": { "type": "number" },
          "paketMi": { "type": "boolean", "default": false },
          "paketKaynak": {
            "type": "string",
            "enum": ["yemeksepeti", "getir", "telefon", null],
            "nullable": true
          },
          "musteriAd": { "type": "string", "nullable": true },
          "musteriTel": { "type": "string", "nullable": true },
          "musteriAdres": { "type": "string", "nullable": true },
          "olusturmaZamani": { "type": "timestamp", "required": true },
          "hazirlandiZamani": { "type": "timestamp", "nullable": true },
          "masayaGittiZamani": { "type": "timestamp", "nullable": true },
          "tamamlandiZamani": { "type": "timestamp", "nullable": true },
          "gecikmeli": { "type": "boolean", "default": false }
        }
      },
      "archivedOrders": {
        "description": "Tamamlanmış ve ödenmiş siparişler",
        "extends": "orders",
        "additionalFields": {
          "arsivZamani": { "type": "timestamp", "required": true },
          "gun": { "type": "string", "format": "YYYY-MM-DD", "indexed": true }
        }
      },
      "payments": {
        "description": "Tahsilatlar",
        "fields": {
          "id": { "type": "string", "required": true },
          "orderId": { "type": "string", "required": true, "ref": "orders" },
          "masaId": { "type": "string", "nullable": true },
          "tutar": { "type": "number", "required": true },
          "yontem": { "type": "string", "enum": ["nakit", "kart", "yemekKarti"], "required": true },
          "kartTipi": {
            "type": "string",
            "nullable": true,
            "enum": ["Multinet", "Sodexo", "Ticket", "Setcard", "Edenred", "Metropol", "Diger", null]
          },
          "kasiyerId": { "type": "string", "required": true },
          "kasiyerAd": { "type": "string" },
          "fisBasildi": { "type": "boolean", "default": true },
          "zaman": { "type": "timestamp", "required": true },
          "gun": { "type": "string", "format": "YYYY-MM-DD", "indexed": true }
        }
      },
      "campaigns": {
        "description": "Kampanyalar",
        "fields": {
          "id": { "type": "string", "required": true },
          "ad": { "type": "string", "required": true },
          "tip": { "type": "string", "enum": ["indirim", "kampanya"], "required": true },
          "oranTipi": { "type": "string", "enum": ["yuzde", "sabitTutar"], "required": true },
          "oran": { "type": "number", "required": true, "description": "% veya TL" },
          "program": {
            "type": "object",
            "properties": {
              "baslangic": { "type": "string", "format": "HH:mm" },
              "bitis": { "type": "string", "format": "HH:mm" },
              "gunler": { "type": "array", "items": { "enum": ["pazartesi", "sali", "carsamba", "persembe", "cuma", "cumartesi", "pazar"] } }
            }
          },
          "aciklama": { "type": "string" },
          "aktif": { "type": "boolean", "default": true },
          "baslangicTarihi": { "type": "timestamp" },
          "bitisTarihi": { "type": "timestamp" }
        }
      },
      "coupons": {
        "description": "Kupon kodları",
        "fields": {
          "id": { "type": "string", "required": true },
          "kod": { "type": "string", "required": true, "unique": true, "description": "Büyük harf, benzersiz" },
          "indirimTipi": { "type": "string", "enum": ["yuzde", "sabitTutar"], "required": true },
          "deger": { "type": "number", "required": true },
          "maksKullanim": { "type": "number", "required": true },
          "kullanimSayisi": { "type": "number", "default": 0 },
          "sonKullanma": { "type": "timestamp", "required": true },
          "aktif": { "type": "boolean", "default": true }
        }
      },
      "notifications": {
        "description": "Sistem bildirimleri",
        "fields": {
          "id": { "type": "string", "required": true },
          "tip": {
            "type": "string",
            "enum": ["gecikme", "dusukStok", "stoktaYok", "yeniPaket", "callerID", "rezervasyon"],
            "required": true
          },
          "baslik": { "type": "string", "required": true },
          "mesaj": { "type": "string", "required": true },
          "hedef": { "type": "string", "enum": ["hepsi", "kasa", "admin"], "default": "hepsi" },
          "ilgiliId": { "type": "string", "nullable": true, "description": "Sipariş/ürün/masa referansı" },
          "okundu": { "type": "boolean", "default": false },
          "zaman": { "type": "timestamp", "required": true }
        }
      },
      "settings": {
        "description": "Sistem ayarları (tek doküman: settings/global)",
        "fields": {
          "gecikmeEsigiDk": { "type": "number", "default": 15, "description": "Sipariş gecikme eşiği (dakika)" },
          "dusukStokEsigi": { "type": "number", "default": 5 },
          "restoranAd": { "type": "string" },
          "restoranAdres": { "type": "string" },
          "restoranTel": { "type": "string" },
          "vergiNo": { "type": "string" },
          "vergiOrani": { "type": "number", "default": 10 },
          "paraBirimi": { "type": "string", "default": "TL" },
          "kdvDahilFiyat": { "type": "boolean", "default": true },
          "kasaAcilis": { "type": "string", "format": "HH:mm" },
          "kasaKapanis": { "type": "string", "format": "HH:mm" },
          "fisBasligi": { "type": "string" },
          "fisAltMesaji": { "type": "string", "default": "Teşekkür ederiz" },
          "mutfakYaziciIp": { "type": "string" },
          "otomatikFisBas": { "type": "boolean", "default": true },
          "bildirimAyarlari": {
            "type": "object",
            "properties": {
              "gecikme": "boolean",
              "dusukStok": "boolean",
              "yeniPaket": "boolean",
              "callerID": "boolean",
              "rezervasyon": "boolean",
              "sesliUyari": "boolean"
            }
          }
        }
      },
      "printers": {
        "description": "Mutfak/bar yazıcıları (kategori-bazlı yönlendirme için)",
        "fields": {
          "id": { "type": "string", "required": true },
          "ad": { "type": "string", "required": true, "examples": ["Mutfak", "Bar", "Pastane"] },
          "ip": { "type": "string", "required": true, "description": "Ağdaki ESC/POS yazıcı IP adresi" },
          "port": { "type": "number", "default": 9100 },
          "varsayilan": { "type": "boolean", "default": false, "description": "Kategorisi yazıcı atanmamış ürünler buraya gider" },
          "aktif": { "type": "boolean", "default": true },
          "createdAt": { "type": "timestamp" }
        }
      },
      "callerLogs": {
        "description": "Gelen telefon aramaları (CallerID)",
        "fields": {
          "id": { "type": "string", "required": true },
          "telefon": { "type": "string", "required": true },
          "ad": { "type": "string", "nullable": true, "description": "Tanınan müşteri adı" },
          "zaman": { "type": "timestamp", "required": true },
          "cevaplandi": { "type": "boolean", "default": false },
          "siparisId": { "type": "string", "nullable": true, "ref": "orders" },
          "notlar": { "type": "string" }
        }
      },
      "reservations": {
        "description": "Masa rezervasyonları",
        "fields": {
          "id": { "type": "string", "required": true },
          "masaId": { "type": "string", "required": true, "ref": "tables" },
          "masaAd": { "type": "string" },
          "musteriAd": { "type": "string", "required": true },
          "musteriTel": { "type": "string", "required": true },
          "kisiSayisi": { "type": "number", "required": true },
          "baslangic": { "type": "timestamp", "required": true },
          "bitis": { "type": "timestamp", "required": true, "description": "Rezervasyon bitiş saati. Masa bu aralıkta 'rezerve' durumunda kalır." },
          "notlar": { "type": "string" },
          "durum": { "type": "string", "enum": ["bekliyor", "geldi", "iptal"], "default": "bekliyor" }
        }
      },
      "stockMovements": {
        "description": "Stok hareketleri. Faz 1'den itibaren her stok değişiminde (sipariş, manuel, sayım, fire) trigger ile yazılır; UI Faz 10'da genişletilir.",
        "fields": {
          "id": { "type": "string", "required": true },
          "productId": { "type": "string", "required": true, "ref": "products" },
          "productAd": { "type": "string" },
          "tip": { "type": "string", "enum": ["giris", "cikis", "sayim", "fire"], "required": true },
          "miktar": { "type": "number", "required": true },
          "oncekiStok": { "type": "number" },
          "yeniStok": { "type": "number" },
          "kaynak": { "type": "string", "enum": ["siparis", "manuel", "satinAlma"] },
          "ilgiliId": { "type": "string", "nullable": true },
          "kullaniciId": { "type": "string", "required": true },
          "zaman": { "type": "timestamp", "required": true },
          "aciklama": { "type": "string" }
        }
      }
    }
  },

  "screens": {
    "admin": {
      "login": {
        "path": "/admin/login",
        "access": ["public"],
        "components": [
          "Restoran logosu",
          "Email input",
          "Şifre input (göster/gizle toggle)",
          "Beni Hatırla checkbox",
          "Giriş Yap butonu",
          "POS Girişi linki"
        ],
        "behaviors": [
          "Email ve şifre formatı validate (zod)",
          "Firebase Auth ile giriş",
          "5 yanlış denemede 60sn kilit",
          "Sadece admin rolü giriş yapabilir",
          "Başarılı → /admin/dashboard"
        ]
      },
      "dashboard": {
        "path": "/admin/dashboard",
        "access": ["admin", "kasiyer"],
        "components": {
          "kpiCards": ["Günlük Satış (TL)", "Aktif Masa", "Bekleyen Sipariş", "Tamamlanan Sipariş"],
          "charts": ["Saatlik satış (line)", "Son 7 gün karşılaştırma (bar)"],
          "lists": ["Son 5 sipariş", "En çok satan 5 ürün (bugün)", "Aktif uyarılar"]
        },
        "behaviors": [
          "Firestore realtime listener ile canlı güncelleme",
          "Karta tıklayınca ilgili detay sayfasına yönlendirme"
        ]
      },
      "categories": {
        "path": "/admin/categories",
        "access": ["admin"],
        "components": {
          "topCards": ["Toplam Kategori", "Aktif Kategori", "Toplam Ürün"],
          "topBar": ["Yeni Kategori Ekle", "Arama", "Sıralamayı Kaydet"],
          "table": {
            "rows": "Drag-drop ile sıralanabilir",
            "columns": ["Tutamak", "Sıra", "Ad", "Ürün sayısı", "Aktif toggle", "Düzenle", "Sil"]
          },
          "modal": ["Kategori adı (zorunlu)", "Aktif toggle", "Kaydet", "İptal"]
        },
        "behaviors": [
          "Drag-drop sıralama anında görsel, kaydet basılınca Firestore'a yazılır",
          "İçinde ürünü olan kategori silinemez (uyarı)",
          "Pasif kategori POS'ta görünmez"
        ]
      },
      "products": {
        "path": "/admin/products",
        "access": ["admin"],
        "components": {
          "topCards": ["Toplam Ürün", "Aktif Ürün", "Düşük Stoklu", "Stokta Yok"],
          "filters": ["Kategori dropdown", "Arama", "Stok durumu", "Excel export"],
          "table": ["Görsel", "Ad", "Kategori", "Fiyat", "Stok", "Durum", "İşlemler"],
          "modal": [
            "Ürün adı (zorunlu)",
            "Kategori (dropdown)",
            "Fiyat (zorunlu, >0)",
            "Stok (zorunlu, >=0)",
            "Düşük stok eşiği (opsiyonel)",
            "Açıklama",
            "Görsel yükleme",
            "Aktif toggle"
          ]
        },
        "behaviors": [
          "Sipariş edildikçe stok otomatik düşer (Cloud Function)",
          "Stok 0 → POS'ta gri ve seçilemez",
          "Stok eşik altında → bildirim oluşur",
          "Pasif ürün QR menü ve POS'ta görünmez"
        ]
      },
      "orders": {
        "path": "/admin/orders",
        "access": ["admin", "kasiyer"],
