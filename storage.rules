rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.rol == 'admin';
    }
    match /{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.rol == 'admin';
    }
  }
}
