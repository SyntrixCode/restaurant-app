rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{file=**} {
      allow read: if true;
      // Giriş yapmış personel ürün görseli yükleyebilir. (Admin'in rol claim'i
      // yok — kod'u olmayan kullanıcıda onUserWrite tetikleyicisi claim set etmiyor.
      // Ürün görseli hassas değil, panel zaten admin/kasiyer ile korunuyor.)
      allow write: if request.auth != null;
    }
    // Tedarikçi fatura belgeleri — admin panelinden yüklenir. Admin'in rol claim'i
    // olmayabildiği için (yukarıdaki gerekçe) auth != null yeterli; okuma da girişli.
    match /tedarikciFaturalari/{file=**} {
      allow read, write: if request.auth != null;
    }
    match /{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.rol == 'admin';
    }
  }
}
